# Terra repository — needed for CoolerControl (coolercontrol/coolercontrold).
#
# Bazzite ships its own copy of this file with the repo DISABLED and flips it on
# at runtime from `ujust install-coolercontrol`. The image build needs it
# enabled up front, so it is declared in the rpm-ostree module's `repos:` and
# replaces the base file at build time.
#
# Keys referenced below are shipped in the base image
# (/etc/pki/rpm-gpg/RPM-GPG-KEY-terra$releasever*).
#
# repo_gpgcheck is OFF on purpose: Terra rotates repomd.xml and its .asc
# separately, so a build hitting that window fails with
# "repomd.xml GPG signature verification error: Bad PGP signature". Package
# signatures (gpgcheck=1) are still enforced, and the repo is only used at image
# build time.

[terra]
name=Terra $releasever
metalink=https://tetsudou.fyralabs.com/metalink?repo=terra$releasever&arch=$basearch
metadata_expire=6h
type=rpm
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-terra$releasever
repo_gpgcheck=0
enabled=1
enabled_metadata=1
countme=1

[terra-source]
name=Terra $releasever - Source
metalink=https://tetsudou.fyralabs.com/metalink?repo=terra$releasever-source&arch=$basearch
metadata_expire=6h
type=rpm
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-terra$releasever-source
repo_gpgcheck=0
enabled=0
enabled_metadata=0
